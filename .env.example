# ============================================================
# VPAP Audit API - Environment Configuration Template
# ============================================================
# Copy this file to .env and provide your actual credentials.
# NEVER commit .env with real credentials to version control.
# ============================================================

# Database Connection
# PostgreSQL connection string for PostgreSQL / Supabase
VPAP_AUDIT_DSN=postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# Authentication & JWT Configuration
# Shared secret used to sign and verify service and operator JWTs
VPAP_AUTH_SECRET=change-this-to-a-secure-random-secret-in-production

# JWT Claims (Optional, defaults shown below)
VPAP_TOKEN_ISSUER=vpap-audit-api-poc
VPAP_TOKEN_AUDIENCE=vpap-persistence-api

# Server Configuration (Optional)
PORT=8000
